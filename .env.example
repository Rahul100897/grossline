# Copy to .env and fill in. Never commit .env.
# Values here are names and shapes only — no real credentials, ever.

# ---- core ----
# local default: development
NODE_ENV=
# local default: postgres://grossline:grossline@localhost:5433/grossline
DATABASE_URL=
# local default: redis://localhost:6380
REDIS_URL=
# test suite database; falls back to DATABASE_URL when unset (CI does this)
TEST_DATABASE_URL=
# RLS-enforced app role connection; derived from DATABASE_URL when unset
APP_DATABASE_URL=

# ---- encryption ----
# base64 32-byte key. Generate: openssl rand -base64 32
# Production key lives in the host's secret manager, never here.
MASTER_KEY=
# integer, current master key version (starts at 1)
MASTER_KEY_VERSION=

# ---- admin auth ----
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ---- Shopify ----
# Per-store custom app access tokens are stored encrypted in the database,
# not here. These are only for the future public app.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# e.g. 2026-07
SHOPIFY_API_VERSION=
# One-shot input for `pnpm connect:shopify` — never stored in this file.
SHOPIFY_STORE_TOKEN=

# ---- Google Ads ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Meta ----
META_APP_ID=
META_APP_SECRET=
# e.g. v21.0
META_API_VERSION=

# ---- email ----
RESEND_API_KEY=
REPORT_FROM_ADDRESS=

# ---- AI commentary ----
ANTHROPIC_API_KEY=

# ---- monitoring ----
SENTRY_DSN=
HEALTHCHECKS_PING_URL=
