# Copy to .env and fill in. Never commit .env.
# Values here are names and shapes only — no real credentials, ever.

# ---- core ----
# local default: development
NODE_ENV=
# local default: postgres://grossline:grossline@localhost:5433/grossline
DATABASE_URL=
# local default: redis://localhost:6380
REDIS_URL=
# test suite database; falls back to DATABASE_URL when unset (CI does this)
TEST_DATABASE_URL=
# RLS-enforced app role connection; derived from DATABASE_URL when unset
APP_DATABASE_URL=

# ---- encryption ----
# base64 32-byte key. Generate: openssl rand -base64 32
# Production key lives in the host's secret manager, never here.
MASTER_KEY=
# integer, current master key version (starts at 1)
MASTER_KEY_VERSION=

# ---- admin auth ----
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# 'true' skips the authenticator step. Local development only — ignored in production.
ADMIN_TOTP_DISABLED=

# ---- Shopify ----
# Dev Dashboard app credentials (OAuth client id/secret). Used for the
# client_credentials grant (own-org stores) and the authorization_code grant
# (merchant stores, custom distribution). Legacy admin-created custom apps
# cannot be created since 2026-01-01; existing shpat_ tokens still work.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Older aliases for the same values; SHOPIFY_CLIENT_* wins when both are set.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# e.g. 2026-07
SHOPIFY_API_VERSION=
# OAuth redirect for the authorization_code install flow.
# local default: http://localhost:3000/api/shopify/callback
# production:    https://admin.getgrossline.com/api/shopify/callback (when deployed)
SHOPIFY_REDIRECT_URI=
# One-shot input for `pnpm connect:shopify ... legacy_static` — never stored here.
SHOPIFY_STORE_TOKEN=

# ---- Google Ads ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Meta ----
META_APP_ID=
META_APP_SECRET=
# e.g. v21.0
META_API_VERSION=

# ---- email ----
RESEND_API_KEY=
REPORT_FROM_ADDRESS=
# From address for support-ticket emails (falls back to ADMIN_EMAIL)
SUPPORT_FROM_EMAIL=

# ---- marketing site ----
# Public admin origin the marketing contact form posts tickets to
PUBLIC_ADMIN_URL=

# ---- AI commentary ----
ANTHROPIC_API_KEY=

# ---- monitoring ----
SENTRY_DSN=
HEALTHCHECKS_PING_URL=
