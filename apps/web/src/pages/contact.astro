---
import Marketing from '../layouts/Marketing.astro';

// The marketing-site support form posts to the admin app's public intake
// endpoint (task 3.7). The endpoint URL is build-time public config; it falls
// back to the local admin app in dev.
const intakeUrl =
  (import.meta.env.PUBLIC_ADMIN_URL ?? 'http://localhost:3000') + '/api/tickets/intake';
---

<Marketing
  title="Grossline — contact"
  description="A question, a bug, or feedback — it reaches us directly."
  path="/contact"
>
  <div class="pagehead">
    <div class="wrap">
      <div class="eyebrow">Contact</div>
      <h1>Get in touch.</h1>
      <p class="lede">
        A question, a bug, or feedback — it reaches us directly. If you'd like your first report,
        the <a href="/free-report" style="color:var(--gl-green)">free-report form</a> is the faster
        route.
      </p>
    </div>
  </div>

  <section style="padding-top:32px">
    <div class="wrap">
      <form id="contact-form" class="formcard" novalidate>
        <div class="field">
          <label for="c-type">Type</label>
          <select id="c-type" name="type">
            <option value="question">Question</option>
            <option value="feedback">Feedback</option>
            <option value="bug">Bug</option>
            <option value="feature">Feature request</option>
          </select>
        </div>
        <div class="field">
          <label for="c-name">Your name</label>
          <input id="c-name" name="submitterName" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="c-email">Email</label>
          <input id="c-email" name="submitterEmail" type="email" autocomplete="email" />
        </div>
        <div class="field">
          <label for="c-subject">Subject</label>
          <input id="c-subject" name="subject" type="text" required />
        </div>
        <div class="field">
          <label for="c-body">Message</label>
          <textarea id="c-body" name="body" rows="6" required></textarea>
        </div>
        <!-- Honeypot: hidden from people, tempting to bots. -->
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px">
          <label>Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="btn">Send</button>
        <p id="status" class="formstatus" role="status"></p>
      </form>
    </div>
  </section>
</Marketing>

<script define:vars={{ intakeUrl }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('status');
  const button = form.querySelector('button');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.textContent = '';
    status.className = 'formstatus';
    const data = Object.fromEntries(new FormData(form).entries());
    if (!data.subject || !data.body) {
      status.textContent = 'A subject and a message are required.';
      status.className = 'formstatus err';
      return;
    }
    button.disabled = true;
    button.textContent = 'Sending…';
    try {
      const response = await fetch(intakeUrl, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          type: data.type || 'question',
          subject: data.subject,
          body: data.body,
          submitterName: data.submitterName || undefined,
          submitterEmail: data.submitterEmail || undefined,
          company: data.company || undefined,
        }),
      });
      if (!response.ok) throw new Error('bad status');
      form.reset();
      status.textContent = 'Thank you — we have it and will be in touch.';
      status.className = 'formstatus ok';
    } catch {
      status.textContent = 'Something went wrong. Please email hello@getgrossline.com instead.';
      status.className = 'formstatus err';
    } finally {
      button.disabled = false;
      button.textContent = 'Send';
    }
  });
</script>
