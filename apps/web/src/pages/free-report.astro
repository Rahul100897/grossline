---
import Marketing from '../layouts/Marketing.astro';

// The free-first-report request posts to the admin app's public intake endpoint
// (task 3.7) with its own ticket type `free_report`, so it lands in the same
// inbox filterable on its own (task 5.C3) and notifies the analyst by email.
const intakeUrl =
  (import.meta.env.PUBLIC_ADMIN_URL ?? 'http://localhost:3000') + '/api/tickets/intake';
---

<Marketing
  title="Grossline — get your first report free"
  description="Request your free first report. Tell us about your store and we'll deliver one full monthly report at no charge, with a call to walk through it."
  path="/free-report"
>
  <div class="pagehead">
    <div class="wrap">
      <div class="eyebrow">Free first report</div>
      <h1>Get your first report free.</h1>
      <p class="lede">
        This is the whole service, delivered once at no charge — a real monthly report on your last
        month, with a call to walk through it. Not a demo, and no card needed. Tell us about your
        store and we'll be in touch.
      </p>
    </div>
  </div>

  <section style="padding-top:32px">
    <div class="wrap">
      <form id="fr-form" class="formcard" novalidate>
        <div class="field">
          <label for="fr-name">Your name</label>
          <input id="fr-name" name="name" type="text" autocomplete="name" />
        </div>
        <div class="field">
          <label for="fr-email">Email</label>
          <input id="fr-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="fr-store">Store URL</label>
          <input
            id="fr-store"
            name="store"
            type="text"
            placeholder="yourstore.myshopify.com or your domain"
            required
          />
        </div>
        <div class="field">
          <label for="fr-spend">Rough monthly ad spend</label>
          <input id="fr-spend" name="spend" type="text" placeholder="e.g. $20k across Google + Meta" />
        </div>
        <div class="field">
          <label for="fr-message">Anything we should know?</label>
          <textarea id="fr-message" name="message" rows="5"></textarea>
        </div>
        <!-- Honeypot: hidden from people, tempting to bots. -->
        <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px">
          <label>Company<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="btn">Request my free report</button>
        <p id="status" class="formstatus" role="status"></p>
      </form>

      <p class="demo-note">
        <a href="/the-report" style="color:var(--gl-green)">See what's in the report first →</a>
      </p>
    </div>
  </section>
</Marketing>

<script define:vars={{ intakeUrl }}>
  const form = document.getElementById('fr-form');
  const status = document.getElementById('status');
  const button = form.querySelector('button');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    status.textContent = '';
    status.className = 'formstatus';
    const d = Object.fromEntries(new FormData(form).entries());
    if (!d.email || !d.store) {
      status.textContent = 'An email and your store URL are required.';
      status.className = 'formstatus err';
      return;
    }
    const body = [
      `Store: ${d.store}`,
      d.spend ? `Monthly ad spend: ${d.spend}` : null,
      d.message ? `\n${d.message}` : null,
    ]
      .filter(Boolean)
      .join('\n');
    button.disabled = true;
    button.textContent = 'Sending…';
    try {
      const response = await fetch(intakeUrl, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          type: 'free_report',
          subject: `Free first report — ${d.store}`,
          body,
          submitterName: d.name || undefined,
          submitterEmail: d.email || undefined,
          company: d.company || undefined,
        }),
      });
      if (!response.ok) throw new Error('bad status');
      form.reset();
      status.textContent = 'Thank you — we have it and will be in touch about your free report.';
      status.className = 'formstatus ok';
    } catch {
      status.textContent = 'Something went wrong. Please email hello@getgrossline.com instead.';
      status.className = 'formstatus err';
    } finally {
      button.disabled = false;
      button.textContent = 'Request my free report';
    }
  });
</script>
