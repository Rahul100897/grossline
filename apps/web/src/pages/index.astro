---
// Marketing homepage — a direct port of docs/design/home.html (design port,
// Step D). Standalone document (its own nav + footer, distinct from Base.astro),
// so the landing page matches the mockup one-to-one. Every colour is a --gl-*
// token from design-tokens.css; no hex is authored here. Copy is carried over
// from the mockup verbatim.
import '../../../../docs/design/design-tokens.css';

const title = 'Grossline — Know what your store actually made';
const description =
  'Grossline reads your Shopify store and your ad accounts together, works out what you actually kept, and sends a short monthly report with two or three things worth changing.';
const site = 'https://getgrossline.com';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grossline" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/sample-report.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <style is:global>
      /* Self-hosted fonts (Step A) — no Google Fonts request. */
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('/fonts/inter.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Instrument Serif';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/instrument-serif.woff2') format('woff2');
      }
      @font-face {
        font-family: 'Instrument Serif';
        font-style: italic;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/instrument-serif-italic.woff2') format('woff2');
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html {
        -webkit-font-smoothing: antialiased;
        scroll-behavior: smooth;
        color-scheme: light;
      }
      body {
        font-family: var(--gl-font-body);
        background: var(--gl-cream);
        color: var(--gl-ink);
        font-feature-settings: 'tnum' 1;
        line-height: 1.5;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      .wrap {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 28px;
      }
      .serif {
        font-family: var(--gl-font-display);
        font-weight: 400;
        letter-spacing: -0.01em;
      }

      /* ---------- buttons ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 24px;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 500;
        background: var(--gl-green);
        color: var(--gl-white);
        border: 1px solid var(--gl-green);
        transition: 0.15s;
      }
      .btn:hover {
        background: var(--gl-green-deep);
        border-color: var(--gl-green-deep);
      }
      .btn.ghost {
        background: transparent;
        color: var(--gl-ink);
        border-color: var(--gl-line);
      }
      .btn.ghost:hover {
        background: var(--gl-cream-2);
        border-color: var(--gl-line-2);
      }
      .btn.light {
        background: var(--gl-white);
        color: var(--gl-green-night);
        border-color: var(--gl-white);
      }
      .btn.outline-light {
        background: transparent;
        color: var(--gl-white);
        border-color: rgba(255, 255, 255, 0.32);
      }
      .btn.sm {
        padding: 9px 17px;
        font-size: 14px;
      }

      /* ---------- nav ---------- */
      nav {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(248, 245, 237, 0.9);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--gl-line);
      }
      nav .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 70px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      .mark {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        flex: none;
      }
      .navlinks {
        display: flex;
        align-items: center;
        gap: 30px;
        font-size: 14.5px;
        color: var(--gl-slate);
      }
      .navlinks a:hover {
        color: var(--gl-ink);
      }

      /* ---------- hero ---------- */
      .hero {
        padding: 76px 0 64px;
      }
      .hero .wrap {
        display: grid;
        grid-template-columns: 1fr 470px;
        gap: 64px;
        align-items: center;
      }
      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--gl-green);
        background: var(--gl-green-soft);
        padding: 6px 13px;
        border-radius: 100px;
        font-weight: 500;
        margin-bottom: 24px;
      }
      h1 {
        font-size: 60px;
        line-height: 1.04;
        letter-spacing: -0.02em;
        font-family: var(--gl-font-display);
        font-weight: 400;
      }
      h1 em {
        font-style: italic;
        color: var(--gl-green);
      }
      .sub {
        margin-top: 24px;
        font-size: 18.5px;
        line-height: 1.62;
        color: var(--gl-slate);
        max-width: 530px;
      }
      .herobtns {
        margin-top: 34px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }
      .microcopy {
        margin-top: 20px;
        font-size: 14px;
        color: var(--gl-slate);
      }
      .microcopy b {
        color: var(--gl-ink);
        font-weight: 500;
      }

      /* ---------- claim gap proof ---------- */
      .proof {
        background: var(--gl-white);
        border: 1px solid var(--gl-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--gl-shadow-card);
      }
      .proof-head {
        padding: 16px 22px;
        border-bottom: 1px solid var(--gl-line);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12.5px;
        color: var(--gl-slate);
      }
      .proof-head b {
        color: var(--gl-ink);
        font-weight: 500;
        font-size: 13.5px;
      }
      .proof-body {
        padding: 8px 22px 22px;
      }
      .claim {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding: 20px 0;
        border-bottom: 1px solid var(--gl-line);
      }
      .claim:last-of-type {
        border-bottom: 0;
      }
      .claim .who {
        font-size: 13px;
        color: var(--gl-slate);
        max-width: 190px;
      }
      .claim .who b {
        display: block;
        color: var(--gl-ink);
        font-weight: 600;
        font-size: 15px;
        margin-bottom: 4px;
      }
      .claim .num {
        text-align: right;
      }
      .claim .big {
        font-size: 34px;
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1;
      }
      .claim .small {
        font-size: 12.5px;
        color: var(--gl-slate);
        margin-top: 5px;
      }
      .verdict {
        margin: 0 -22px -22px;
        padding: 18px 22px;
        background: var(--gl-rust-soft);
        border-top: 1px solid var(--gl-rust-line);
        display: flex;
        gap: 12px;
        align-items: flex-start;
      }
      .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--gl-rust);
        margin-top: 7px;
        flex: none;
      }
      .verdict p {
        font-size: 14px;
        line-height: 1.55;
        color: var(--gl-rust-text);
      }
      .verdict b {
        font-weight: 600;
        color: var(--gl-rust);
      }

      /* ---------- strip ---------- */
      .strip {
        border-top: 1px solid var(--gl-line);
        border-bottom: 1px solid var(--gl-line);
        background: var(--gl-cream-2);
      }
      .strip .wrap {
        display: flex;
        gap: 0;
        padding: 0;
      }
      .strip .cell {
        flex: 1;
        padding: 22px 28px;
        border-right: 1px solid var(--gl-line);
        font-size: 14px;
        color: var(--gl-slate);
      }
      .strip .cell:last-child {
        border-right: 0;
      }
      .strip .cell b {
        display: block;
        color: var(--gl-ink);
        font-weight: 600;
        font-size: 15px;
        margin-bottom: 3px;
      }

      /* ---------- sections ---------- */
      section {
        padding: 96px 0;
      }
      .eyebrow {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--gl-green);
        margin-bottom: 16px;
      }
      h2 {
        font-size: 42px;
        line-height: 1.12;
        letter-spacing: -0.02em;
        max-width: 700px;
        font-family: var(--gl-font-display);
        font-weight: 400;
      }
      h2 em {
        font-style: italic;
        color: var(--gl-green);
      }
      .lede {
        margin-top: 18px;
        font-size: 17.5px;
        line-height: 1.65;
        color: var(--gl-slate);
        max-width: 640px;
      }

      /* ---------- problem ---------- */
      .problem {
        background: var(--gl-green-night);
        color: var(--gl-green-fog);
      }
      .problem h2 {
        color: var(--gl-white);
      }
      .problem h2 em {
        color: var(--gl-green-accent);
      }
      .problem .lede {
        color: var(--gl-green-muted-2);
      }
      .problems {
        margin-top: 52px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--gl-green-line-2);
        border: 1px solid var(--gl-green-line-2);
        border-radius: 14px;
        overflow: hidden;
      }
      .pcard {
        background: var(--gl-green-night);
        padding: 32px 30px;
      }
      .pcard .n {
        font-family: var(--gl-font-display);
        font-size: 34px;
        color: var(--gl-green-numeral);
        line-height: 1;
      }
      .pcard h3 {
        margin-top: 16px;
        font-size: 19px;
        font-weight: 600;
        color: var(--gl-white);
        letter-spacing: -0.01em;
      }
      .pcard p {
        margin-top: 11px;
        font-size: 15px;
        line-height: 1.65;
        color: var(--gl-green-muted-2);
      }

      /* ---------- what you get ---------- */
      .gets {
        margin-top: 56px;
        border-top: 1px solid var(--gl-line);
      }
      .get {
        display: grid;
        grid-template-columns: 56px 1fr 250px;
        gap: 32px;
        padding: 34px 0;
        border-bottom: 1px solid var(--gl-line);
        align-items: start;
      }
      .get .idx {
        font-family: var(--gl-font-display);
        font-size: 30px;
        color: var(--gl-green);
        line-height: 1;
      }
      .get h3 {
        font-size: 21px;
        font-weight: 600;
        letter-spacing: -0.015em;
      }
      .get p {
        margin-top: 9px;
        font-size: 15.5px;
        line-height: 1.65;
        color: var(--gl-slate);
        max-width: 520px;
      }
      .get .figure {
        text-align: right;
      }
      .get .figure .v {
        font-size: 30px;
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.1;
      }
      .get .figure .k {
        font-size: 13px;
        color: var(--gl-slate);
        margin-top: 6px;
      }
      .get .figure .v.good {
        color: var(--gl-green);
      }
      .get .figure .v.bad {
        color: var(--gl-rust);
      }

      /* ---------- report showcase ---------- */
      .showcase {
        background: var(--gl-cream-2);
        border-top: 1px solid var(--gl-line);
        border-bottom: 1px solid var(--gl-line);
      }
      .showcase .wrap {
        display: grid;
        grid-template-columns: 440px 1fr;
        gap: 64px;
        align-items: center;
      }
      .checks {
        margin-top: 30px;
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .check {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        font-size: 15.5px;
        line-height: 1.6;
      }
      .tick {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--gl-green-soft);
        color: var(--gl-green);
        flex: none;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        margin-top: 2px;
      }

      /* ---------- image placeholder ---------- */
      .ph {
        border: 1.5px dashed var(--gl-ph-border);
        border-radius: 14px;
        background: repeating-linear-gradient(
          45deg,
          var(--gl-cream-2),
          var(--gl-cream-2) 10px,
          var(--gl-ph-stripe) 10px,
          var(--gl-ph-stripe) 20px
        );
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 34px 26px;
        color: var(--gl-ph-text);
      }
      .ph .lbl {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--gl-green);
      }
      .ph .name {
        margin-top: 9px;
        font-size: 15px;
        font-weight: 600;
        color: var(--gl-ph-name);
      }
      .ph .desc {
        margin-top: 7px;
        font-size: 13px;
        line-height: 1.5;
        max-width: 320px;
      }

      /* ---------- real image ---------- */
      .shot {
        border-radius: 16px;
        overflow: hidden;
        background: var(--gl-cream-2);
        box-shadow: var(--gl-shadow-image);
      }
      .shot img {
        display: block;
        width: 100%;
        height: auto;
      }

      /* ---------- steps ---------- */
      .steps {
        margin-top: 56px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 26px;
      }
      .step {
        background: var(--gl-white);
        border: 1px solid var(--gl-line);
        border-radius: 14px;
        padding: 30px 28px;
      }
      .step .badge {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: var(--gl-green);
        color: var(--gl-white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 600;
      }
      .step h3 {
        margin-top: 18px;
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .step p {
        margin-top: 10px;
        font-size: 15px;
        line-height: 1.65;
        color: var(--gl-slate);
      }
      .step .time {
        margin-top: 16px;
        font-size: 13px;
        color: var(--gl-green);
        font-weight: 500;
      }

      /* ---------- different ---------- */
      .diffs {
        margin-top: 52px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--gl-line);
        border: 1px solid var(--gl-line);
        border-radius: 14px;
        overflow: hidden;
      }
      .diff {
        background: var(--gl-white);
        padding: 30px 28px;
      }
      .diff h3 {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .diff p {
        margin-top: 10px;
        font-size: 15px;
        line-height: 1.65;
        color: var(--gl-slate);
      }

      /* ---------- pricing ---------- */
      .pricing {
        background: var(--gl-green-night);
        color: var(--gl-green-fog);
      }
      .pricing h2 {
        color: var(--gl-white);
      }
      .pricing h2 em {
        color: var(--gl-green-accent);
      }
      .pricing .lede {
        color: var(--gl-green-muted-2);
      }
      .tiers {
        margin-top: 54px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
      }
      .tier {
        background: var(--gl-green-tier);
        border: 1px solid var(--gl-green-line-2);
        border-radius: 16px;
        padding: 32px 28px;
        display: flex;
        flex-direction: column;
      }
      .tier.feature {
        background: var(--gl-white);
        color: var(--gl-ink);
        border-color: var(--gl-white);
        position: relative;
      }
      .tier .tag {
        position: absolute;
        top: -12px;
        left: 28px;
        background: var(--gl-gold-display);
        color: var(--gl-gold-text);
        font-size: 11.5px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 100px;
        letter-spacing: 0.03em;
      }
      .tier .name {
        font-size: 19px;
        font-weight: 600;
      }
      .tier .for {
        margin-top: 6px;
        font-size: 14px;
        color: var(--gl-green-muted-2);
      }
      .tier.feature .for {
        color: var(--gl-slate);
      }
      .tier .price {
        margin-top: 26px;
        font-family: var(--gl-font-display);
        font-size: 46px;
        line-height: 1;
        letter-spacing: -0.02em;
      }
      .tier .per {
        font-family: var(--gl-font-body);
        font-size: 15px;
        color: var(--gl-green-muted-2);
        letter-spacing: 0;
      }
      .tier.feature .per {
        color: var(--gl-slate);
      }
      .tier ul {
        margin-top: 26px;
        list-style: none;
        font-size: 15px;
        line-height: 1.5;
        flex: 1;
      }
      .tier li {
        padding: 11px 0;
        border-top: 1px solid var(--gl-green-line-2);
        color: var(--gl-green-list);
        display: flex;
        gap: 10px;
      }
      .tier.feature li {
        border-top-color: var(--gl-line);
        color: var(--gl-slate);
      }
      .tier li:before {
        content: '—';
        color: var(--gl-green-numeral);
        flex: none;
      }
      .tier.feature li:before {
        color: var(--gl-green);
      }
      .tier li b {
        color: var(--gl-white);
        font-weight: 500;
      }
      .tier.feature li b {
        color: var(--gl-ink);
      }
      .tier .btn {
        margin-top: 26px;
        width: 100%;
      }
      .pricenote {
        margin-top: 28px;
        font-size: 14.5px;
        color: var(--gl-green-muted-2);
        line-height: 1.7;
      }
      .pricenote b {
        color: var(--gl-white);
        font-weight: 500;
      }

      /* ---------- analyst ---------- */
      .analyst .wrap {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 56px;
        align-items: center;
      }
      .quote {
        font-family: var(--gl-font-display);
        font-size: 30px;
        line-height: 1.35;
        letter-spacing: -0.01em;
      }
      .byline {
        margin-top: 24px;
        font-size: 15px;
        color: var(--gl-slate);
      }
      .byline b {
        display: block;
        color: var(--gl-ink);
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 3px;
      }

      /* ---------- faq ---------- */
      .faqs {
        margin-top: 48px;
        border-top: 1px solid var(--gl-line);
      }
      .faq {
        padding: 26px 0;
        border-bottom: 1px solid var(--gl-line);
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 40px;
      }
      .faq h3 {
        font-size: 17px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .faq p {
        font-size: 15.5px;
        line-height: 1.68;
        color: var(--gl-slate);
      }

      /* ---------- close ---------- */
      .close {
        background: var(--gl-green);
        color: var(--gl-white);
      }
      .close .wrap {
        padding: 88px 28px;
        text-align: center;
        max-width: 780px;
      }
      .close h2 {
        color: var(--gl-white);
        font-size: 46px;
        margin: 0 auto;
      }
      .close .lede {
        color: var(--gl-green-pale);
        margin: 20px auto 0;
      }
      .close .herobtns {
        justify-content: center;
        margin-top: 36px;
      }
      .close .microcopy {
        color: var(--gl-green-pale-2);
      }

      footer {
        background: var(--gl-green-night);
        color: var(--gl-green-foot);
        padding: 56px 0 44px;
        font-size: 14px;
      }
      footer .wrap {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 40px;
      }
      footer .brand {
        color: var(--gl-white);
        margin-bottom: 14px;
      }
      footer p {
        line-height: 1.7;
        max-width: 280px;
      }
      footer h4 {
        color: var(--gl-white);
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 14px;
      }
      footer li {
        list-style: none;
        padding: 6px 0;
      }
      footer a:hover {
        color: var(--gl-white);
      }
      .legal {
        border-top: 1px solid var(--gl-green-line-2);
        margin-top: 44px;
        padding-top: 24px;
        font-size: 13px;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
      }

      /* ---------- responsive ---------- */
      @media (max-width: 1080px) {
        .hero .wrap {
          grid-template-columns: 1fr;
          gap: 48px;
        }
        .proof {
          max-width: 520px;
        }
        h1 {
          font-size: 50px;
        }
        .showcase .wrap,
        .analyst .wrap {
          grid-template-columns: 1fr;
          gap: 40px;
        }
        .problems,
        .steps,
        .tiers {
          grid-template-columns: 1fr;
        }
        .strip .wrap {
          flex-direction: column;
        }
        .strip .cell {
          border-right: 0;
          border-bottom: 1px solid var(--gl-line);
        }
        .strip .cell:last-child {
          border-bottom: 0;
        }
        .get {
          grid-template-columns: 44px 1fr;
          gap: 22px;
        }
        .get .figure {
          grid-column: 2;
          text-align: left;
          display: flex;
          align-items: baseline;
          gap: 10px;
          margin-top: 14px;
        }
        .get .figure .k {
          margin-top: 0;
        }
        .diffs {
          grid-template-columns: 1fr;
        }
        .faq {
          grid-template-columns: 1fr;
          gap: 10px;
        }
        footer .wrap {
          grid-template-columns: 1fr 1fr;
        }
      }
      @media (max-width: 720px) {
        .wrap {
          padding: 0 20px;
        }
        .navlinks a:not(.btn) {
          display: none;
        }
        section {
          padding: 64px 0;
        }
        .hero {
          padding: 48px 0 44px;
        }
        h1 {
          font-size: 38px;
          line-height: 1.1;
        }
        .sub {
