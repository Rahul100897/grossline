# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
.astro/
out/
*.tsbuildinfo

# environment — never commit real values
.env
.env.*
!.env.example

# credentials and keys — nothing here should ever exist in the repo
*.pem
*.key
*.p12
*.jks
service-account*.json
google-ads.yaml
credentials.json

# local data
*.sqlite
*.db
pgdata/
redisdata/
/tmp/
docs/scratch/

# generated reports and exports (root-level output dirs only — NOT source dirs
# like services/worker/src/reports)
/reports/
/exports/
*.pdf
!docs/**/*.pdf
# The marketing sample report is a committed site asset (generated by the Part B
# pipeline from the demo tenant; regenerate with the tmp-sample flow in B/C).
!apps/web/public/sample-report.pdf

# test output
coverage/
playwright-report/
test-results/
.vitest/

# editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# Claude Code local state
.claude/local/
.claude/settings.local.json
